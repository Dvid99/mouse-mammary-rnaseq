// Run from the repository root:  nextflow run workflow/main.nf -profile conda

params {
    samples           = "config/samples.tsv"
    reads_dir         = "data/raw"
    hisat2_index_dir  = "data/reference/mm10"
    hisat2_index_name = "genome"
    gtf               = "data/reference/gencode.vM10.annotation.gtf"
    outdir            = "results_nextflow"

    hisat2_k          = 1
    stranded          = "no"
    qualimap_mem      = "4000M"
}

process {
    cpus   = 2
    memory = '4 GB'

    withName: 'HISAT2_ALIGN' { cpus = 8; memory = '16 GB' }
    withName: 'QUALIMAP_RNASEQ' { memory = '6 GB' }
}

profiles {
    conda {
        conda.enabled  = true
        process.conda  = "${projectDir}/../envs/upstream.yml"
    }
    test {
        // Tiny 1,000-read FASTQs from the Galaxy Training Network (Zenodo 4249516)
        params.reads_dir         = "data/test"
        // Cap every process (incl. HISAT2_ALIGN) to fit a small machine, e.g. Google Colab
        process.resourceLimits   = [cpus: 2, memory: 10.GB]
    }
}

manifest {
    name            = 'mouse-mammary-rnaseq'
    author          = 'David Gómez Collado'
    description     = 'RNA-seq reads-to-counts workflow (Fu et al. 2015, GSE60450)'
    nextflowVersion = '>=23.04.0'
}
